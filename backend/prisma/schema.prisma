generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id     String  @id @default(uuid())
  name   String
  venues Venue[]
}

model Venue {
  id      String  @id @default(uuid())
  cityId  String
  city    City    @relation(fields: [cityId], references: [id])
  name    String
  address String
  screens Screen[]
}
model Screen {
  id      String @id @default(uuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])
  name    String
  seats   Seat[]
}

enum SeatType {
  SILVER
  GOLD
  PLATINUM
}

model Seat {
  id         String   @id @default(uuid())
  screenId   String
  screen     Screen   @relation(fields: [screenId], references: [id])
  rowLabel   String
  seatNumber Int
  seatType   SeatType @default(SILVER)
  bookingSeats BookingSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@index([screenId])
}
model Movie {
  id              String  @id @default(uuid())
  title           String
  durationMinutes Int
  posterUrl       String?
  shows           Show[]
}

model Show {
  id        String   @id @default(uuid())
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id])
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id])
  startTime DateTime
  endTime   DateTime
  basePrice Decimal  @db.Decimal(10, 2)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@index([screenId, startTime])
}
enum Role {
  USER
  ADMIN
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  role            Role            @default(USER)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime        @default(now())
}
enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  showId         String
  show           Show          @relation(fields: [showId], references: [id])
  status         BookingStatus @default(HELD)
  totalAmount    Decimal       @db.Decimal(10, 2)
  idempotencyKey String        @unique
  bookingSeats   BookingSeat[]
  payment        Payment?
  createdAt      DateTime      @default(now())

  @@index([showId])
  @@index([userId])
}
model BookingSeat {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  seatId    String
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@unique([bookingId, seatId])
  @@index([seatId])
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  gatewayTxnId   String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
}
enum WaitlistStatus {
  WAITING
  OFFERED
  CLAIMED
  EXPIRED
}

model WaitlistEntry {
  id        String         @id @default(uuid())
  showId    String
  show      Show           @relation(fields: [showId], references: [id])
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  seatCount Int
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  @@index([showId, status])
}