generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id     String  @id @default(uuid())
  name   String
  venues Venue[]
}

model Venue {
  id      String  @id @default(uuid())
  cityId  String
  city    City    @relation(fields: [cityId], references: [id])
  name    String
  address String
  screens Screen[]
}
model Screen {
  id      String @id @default(uuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])
  name    String
  seats   Seat[]
}

enum SeatType {
  SILVER
  GOLD
  PLATINUM
}

model Seat {
  id         String   @id @default(uuid())
  screenId   String
  screen     Screen   @relation(fields: [screenId], references: [id])
  rowLabel   String
  seatNumber Int
  seatType   SeatType @default(SILVER)

  @@unique([screenId, rowLabel, seatNumber])
  @@index([screenId])
}